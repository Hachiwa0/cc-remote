[Unit]
Description=cc-remote relay (WebSocket relay + static web client)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ccremote
Group=ccremote
WorkingDirectory=/opt/cc-remote
EnvironmentFile=/opt/cc-remote/.env
ExecStart=/opt/cc-remote/.venv/bin/python -m cc_remote.relay
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
