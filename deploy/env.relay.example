# /opt/cc-remote/.env  (ON THE VPS)
# Generate strong tokens with:  openssl rand -hex 32
RELAY_HOST=127.0.0.1
RELAY_PORT=8765
CLIENT_TOKEN=REPLACE_WITH_STRONG_CLIENT_TOKEN
WRAPPER_TOKEN=REPLACE_WITH_STRONG_WRAPPER_TOKEN
# Built web client (scp web/dist here from your dev machine after building
# with VITE_CLIENT_TOKEN = the same CLIENT_TOKEN above).
WEB_STATIC_DIR=/opt/cc-remote/web/dist
LOG_LEVEL=INFO
