[Unit]
Description=cc-remote wrapper (drives local Claude Code, dials the relay over wss)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change User / paths to match the account that runs Claude Code on this machine.
User=youruser
WorkingDirectory=/home/youruser/claude-workspace/cc-remote
EnvironmentFile=/home/youruser/claude-workspace/cc-remote/.env
# systemd runs a minimal PATH that won't include ~/.local/bin where the claude
# CLI lives — add it so the SDK can spawn cc.
Environment="PATH=/home/youruser/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/youruser/claude-workspace/cc-remote/.venv/bin/python -m cc_remote.wrapper
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
