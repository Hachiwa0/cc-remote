[Unit]
Description=cc-remote wrapper (drives local Claude Code, dials the relay over wss)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change User + the three paths below to match the account that runs Claude Code.
User=youruser
WorkingDirectory=/path/to/cc-remote
EnvironmentFile=/path/to/cc-remote/.env
# systemd's minimal PATH won't include ~/.local/bin where the claude CLI may
# live — add it so the SDK can spawn cc.
Environment="PATH=/home/youruser/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/path/to/cc-remote/.venv/bin/python -m cc_remote.wrapper
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
