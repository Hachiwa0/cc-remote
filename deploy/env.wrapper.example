# .env on the machine where `claude` runs.
# WRAPPER_TOKEN MUST match the relay's WRAPPER_TOKEN.
RELAY_URL=wss://your-domain.com/ws
WRAPPER_TOKEN=REPLACE_WITH_STRONG_WRAPPER_TOKEN
# cwd of the claude session. Must match for --resume to find the session jsonl.
CC_CWD=/path/to/your/project
LOG_LEVEL=INFO
