# /home/youruser/claude-workspace/cc-remote/.env  (ON THE COMPANY MACHINE)
# WRAPPER_TOKEN MUST match the relay's WRAPPER_TOKEN.
RELAY_URL=wss://cc-remote.example.com/ws
WRAPPER_TOKEN=REPLACE_WITH_STRONG_WRAPPER_TOKEN
# cwd of the cc session. Must match for --resume to find the session jsonl.
CC_CWD=/home/youruser/claude-workspace/cc-remote
LOG_LEVEL=INFO
