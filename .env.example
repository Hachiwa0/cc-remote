# cc-remote local .env — single machine (relay + wrapper share this file).
# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32

# ---- Relay: web login + wrapper auth ----
RELAY_HOST=127.0.0.1
RELAY_PORT=8765
# Web login password (what you type in the browser). REQUIRED.
LOGIN_PASSWORD=change-me-login
# HMAC secret for signing web session tokens. REQUIRED.
SESSION_SECRET=change-me-openssl-rand-hex-32
# Shared token between wrapper and relay (must match on both).
WRAPPER_TOKEN=change-me-wrapper
# Serve the built web client (web/dist) from the relay, same origin.
WEB_STATIC_DIR=web/dist

# ---- Wrapper ----
RELAY_URL=ws://127.0.0.1:8765/ws
# Working directory of the claude session. MUST match for --resume to find the
# session jsonl under ~/.claude/projects/.
CC_CWD=/path/to/your/project
# Resume a specific session UUID; blank = fresh session. The id is persisted to
# ~/.cc-remote/ after first start.
CC_RESUME_SESSION_ID=

# ---- Wrapper tuning (optional) ----
MAX_CONCURRENT_SESSIONS=20
DRAIN_TIMEOUT=15
RING_MAX_EVENTS=2000
RING_MAX_BYTES=4194304
TOOL_RESULT_MAX=65536

# ---- Logging ----
LOG_LEVEL=INFO
