# ---- Relay ----
RELAY_HOST=127.0.0.1
RELAY_PORT=8765
# Two independent tokens so one can be rotated without the other.
CLIENT_TOKEN=change-me-client
WRAPPER_TOKEN=change-me-wrapper

# ---- Wrapper ----
# WebSocket URL of the relay the wrapper dials (outbound only).
RELAY_URL=ws://127.0.0.1:8765/ws
# Working directory for the cc session. MUST match the resumed session's cwd,
# otherwise --resume cannot find the session jsonl under ~/.claude/projects/.
CC_CWD=/home/youruser/claude-workspace/cc-remote
# Resume a specific cc session id (UUID). Leave blank for a fresh session.
# Once a session starts, its id is persisted to ~/.cc-remote/session.json and
# reused on wrapper restart.
CC_RESUME_SESSION_ID=

# ---- Wrapper tuning ----
RING_MAX_EVENTS=2000
RING_MAX_BYTES=4194304
TOOL_RESULT_MAX=65536
# Seconds to wait for the terminal ResultMessage after interrupt() before
# forcing an SDK reconnect (drain safety net).
DRAIN_TIMEOUT=15

# ---- Logging ----
LOG_LEVEL=INFO
